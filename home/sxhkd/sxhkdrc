# ~/.config/sxhkd/sxhkdrc  (XFCE / Xfwm4 / X11)
#
# Super+i, then: h = left half, j = bottom half, k = top half, l = right half, m = maximize toggle
# Not yet snapped to that half -> unmaximize and snap.
# Already snapped -> focus another window in that half (repeated presses cycle through them).
# Already snapped and no other window there -> move to the same half of the adjacent monitor
# in that direction (nothing happens if there is no monitor that way).
#
# The logic lives at the bottom of THIS file on lines starting with "#@". sxhkd ignores them as comments;
# each binding strips the prefix with sed and pipes the result to sh. One file, no helper script,
# and every binding stays short (no brace expansion, no long inline commands to overflow sxhkd's buffer).
# Needs: wmctrl, xprop, xwininfo, xdpyinfo (x11-utils), xrandr (fallback only).
# If you start sxhkd with -c, change the path below to match.

super + i ; h
	sed -n 's/^#@//p' "$HOME/.config/sxhkd/sxhkdrc" | sh -s left

super + i ; j
	sed -n 's/^#@//p' "$HOME/.config/sxhkd/sxhkdrc" | sh -s bottom

super + i ; k
	sed -n 's/^#@//p' "$HOME/.config/sxhkd/sxhkdrc" | sh -s top

super + i ; l
	sed -n 's/^#@//p' "$HOME/.config/sxhkd/sxhkdrc" | sh -s right

super + i ; m
	sed -n 's/^#@//p' "$HOME/.config/sxhkd/sxhkdrc" | sh -s max

# Alt+[ / Alt+] = previous / next media track (Windows OEM_4 / OEM_6)
alt + bracketleft
	xdotool key --clearmodifiers XF86AudioPrev

alt + bracketright
	xdotool key --clearmodifiers XF86AudioNext

