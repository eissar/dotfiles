; NOTE: make sure to add (in ~/.gitconfig):
;
; [include]
;     path = ~/dotfiles/.gitconfig
;


[user]
    email = eshaanissar@outlook.com
    name = Eshaan Issar
[alias]
    rmc = rm --cached
    stat = status
    ;rmc = rm --cached:w
[core]
    editor = nvim
[merge]
    tool = nvimdiff2
    ;tool = nvimdiff

[status]
    submoduleSummary = false

[diff]
    ignoreSubmodules = all

[help]
    format = web

[browser "man_hack"]
    cmd = cat \"$@\" | wsl bash -c 'pandoc -f html -t plain | batcat -l man -pp'

[web]
    browser= man_hack

# pi writes machine-local state into its settings.json; strip it so the dotfiles copy stays shareable.
# Applied via the dotfiles repo's .gitattributes. https://github.com/earendil-works/pi/issues/10187
[filter "pi-settings"]
    clean = "jq 'del(.deviceId, .lastChangelogVersion)'"
    # Identity smudge so checkout/stash/pull write the blob back instead of
    # aborting. Without this, `required = true` makes any write of the file
    # fatal and leaves it missing from the worktree.
    smudge = cat
    # Fail instead of committing unfiltered content if jq is missing
    required = true
